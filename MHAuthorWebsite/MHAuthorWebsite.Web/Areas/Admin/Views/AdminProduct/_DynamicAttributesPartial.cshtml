@using MHAuthorWebsite.Core.Models.Enums
@using MHAuthorWebsite.Web.Utils.Mappers
@using MHAuthorWebsite.Web.ViewModels.Admin.Product
@using MHAuthorWebsite.Core.Common.Extensions
@model ICollection<AttributeValueForm>

@for (int i = 0; i < Model.Count; i++)
{
	AttributeValueForm a = Model.ElementAt(i);
	string inputType = AttributeDataTypeMapper.HtmlInputTypes[a.DataType];
	string containerClass = AttributeDataTypeMapper.CssContainerClass[a.DataType];

	SelectList displayPositions = new SelectList(
		Enum.GetValues(typeof(ProductAttributeDisplayPosition))
			.Cast<ProductAttributeDisplayPosition>()
			.Select(e => new SelectListItem
			{
				Value = e.ToString(),
				Text = e.GetDisplayName()
			}),
		"Value",
		"Text",
		a.DisplayPosition.ToString()
		);

	SelectList? selectInput = null;
	if(a.DataType == AttributeDataType.Dropdown || inputType == "select")
	{
		selectInput = new SelectList(
			a.PredefinedValues
				.Select(v => new SelectListItem
				{
					Value = v.Id.ToString(),
					Text = v.Value
				}),
			"Value",
			"Text",
			a.ProductAttributeOptionId
		);
	}

	<div class="form-input-row two-to-one flex-row">
		<div class="form-input-box flex-column @containerClass">
			<input type="hidden" name="Attributes[@i].AttributeDefinitionId" value="@a.AttributeDefinitionId" />
			<label class="form-label">@a.Label:</label>
			
			@if (selectInput == null)
			{
				@if (a.IsRequired)
				{
					<input type="@inputType"
					       name="Attributes[@i].Value"
					       class="form-input"
					       data-val="true"
					       data-val-required="Полето е задължително."
					       value="@a.Value" />
				}
				else
				{
					<input type="@inputType"
					       name="Attributes[@i].Value"
					       class="form-input"
					       value="@a.Value" />
				}
			}
			else
			{
				<select class="wide select-main"
				        autocomplete="off"
						name="Attributes[@i].ProductAttributeOptionId"
				        asp-items="@selectInput">
				</select>
			}

			<input type="hidden" name="Attributes[@i].Key" value="@a.Key" />
			<input type="hidden" name="Attributes[@i].Label" value="@a.Label" />
			<input type="hidden" name="Attributes[@i].AttributeDefinitionId" value="@a.AttributeDefinitionId" />

			<span class="input-error"
				  data-valmsg-for="Attributes[@i].Value"
				  data-valmsg-replace="true"></span>
		</div>

		<div class="form-input-box flex-column ">
			<label class="form-label">Позиция на показване:</label>
			<select class=" wide select-main" autocomplete="off" name="Attributes[@i].DisplayPosition" asp-items="@displayPositions"></select>
			<span class="input-error" data-valmsg-for="Attributes[@i].DisplayPosition" data-valmsg-replace="true"></span>
		</div>
	</div>
}
