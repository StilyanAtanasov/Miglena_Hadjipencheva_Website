@using MHAuthorWebsite.Web.ViewModels.Admin.Product
@model ICollection<ProductListItemViewModel>

@{
	ViewData["Title"] = "Управление на продуктите";
	ViewData["CurrentPage"] = Pages.Admin.AllProducts;
}

@section Styles
{
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.22.3/dist/sweetalert2.min.css">
	<link rel="stylesheet" href="~/css/elements/notification.css" />
	<link rel="stylesheet" href="~/css/admin/admin-table.css" />
}

<section class="page-wrapper flex-column">
	<h1 class="title">@ViewData["Title"]</h1>
	<a class="btn link flex-row element-top-right" asp-area="Admin" asp-controller="AdminProduct" asp-action="AddProduct">
		<i class="fa-solid fa-plus"></i>
		Добави продукт
	</a>

	<table class="table">
		<thead>
			<tr>
				<th>Име</th>
				<th class="align-center">Категория</th>
				<th class="align-center">Цена</th>
				<th class="align-center">Количество</th>
				<th class="align-end">Действия</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="6">Няма добавени продукти.</td>
				</tr>
			}
			else
			{
				foreach (ProductListItemViewModel product in Model)
				{
					<tr>
						<td><a class="link active" data-trigger="load-unlimited" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></td>
						<td class="align-center">@product.ProductTypeName</td>
						<td class="align-center">@product.Price.ToString("F2") €</td>
						<td class="align-center">@product.StockQuantity</td>
						<td class="actions-column action-btns flex-row">
							<form asp-area="Admin" asp-controller="AdminProduct" asp-action="TogglePublicity" asp-route-productId="@product.Id" method="post">
								@if (product.IsPublic)
								{
									<button data-trigger="load-unlimited" type="submit" class="btn btn-blue flex-row"> <i class="fa-solid fa-eye-low-vision"></i> Скрий</button>
								}
								else
								{
									<button data-trigger="load-unlimited" type="submit" class="btn btn-blue flex-row"> <i class="fa-solid fa-eye"></i> Публикувай</button>
								}
							</form>

							@if (product.HasActiveDiscount)
							{
								<form asp-area="Admin" asp-controller="AdminProduct" asp-action="EndDiscount" method="post">
									<input type="hidden" name="productId" value="@product.Id" />
									<button type="button" class="btn link btn-purple flex-row" data-action="end-discount">
										<i class="fa-solid fa-calendar-minus"></i>
										Премахни промоция
									</button>
								</form>
							}
							else
							{
								<a data-trigger="load-unlimited" asp-area="Admin" asp-controller="AdminProduct" asp-action="AddDiscount" asp-route-productId="@product.Id" class="btn link btn-purple flex-row">
									<i class="fa-solid fa-percent"></i>
									Нова промоция
								</a>
							}

							<a data-trigger="load-unlimited" asp-area="Admin" asp-controller="AdminProduct" asp-action="EditProduct" asp-route-productId="@product.Id" class="btn link btn-orange flex-row">
								<i class="fa-solid fa-pen-to-square"></i>
								Редактирай
							</a>

							<form asp-area="Admin" asp-controller="AdminProduct" asp-action="DeleteProduct" asp-route-productId="@product.Id" method="post">
								<button type="button" class="btn btn-red flex-row" data-action="delete-product">
									<i class="fa-solid fa-trash-can"></i>
									Изтрий
								</button>
							</form>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</section>

@section Scripts
{
	<script type="module" src="~/js/elements/loader.js" asp-append-version="true"></script>
	<script type="module" src="~/js/admin/product-list.js" asp-append-version="true"></script>
}
