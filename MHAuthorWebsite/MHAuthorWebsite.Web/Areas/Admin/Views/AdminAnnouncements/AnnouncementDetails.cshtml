@using MHAuthorWebsite.Web.ViewModels.Admin.Announcements
@using static MHAuthorWebsite.GCommon.ApplicationRules.Application
@model AnnouncementDetailsViewModel

@{
	ViewData["Title"] = "Детайли на съобщение";
	ViewData["CurrentPage"] = Pages.Admin.AnnouncementsBoardPage;
	ViewData["RequireTimeZoneManager"] = true;

	TimeZoneInfo defaultZone = TimeZoneInfo.FindSystemTimeZoneById(DefaultTimeZoneId);
}

@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
	<link rel="stylesheet" href="~/css/elements/editor.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/admin/announcement-details.css" asp-append-version="true" />
}

<section class="page-wrapper announcements-page flex-column">
	<a asp-controller="AdminAnnouncements" asp-action="AnnouncementsBoard" class="btn link flex-row announcement-back-btn">
		<i class="fa-regular fa-arrow-left"></i>
		Обратно към съобщенията
	</a>

	<article class="announcement-details-shell flex-column">
		<header class="announcement-details-head flex-column">
			<h1 class="title-small">@Model.Subject</h1>

			<div class="announcement-details-meta flex-row">
				<span class="recipient-chip">@Model.RecipientGroupLabel</span>
				<span class="meta-line"><i class="fa-regular fa-circle-check"></i>@Model.RecipientCount успешни</span>
				<span class="meta-line"><i class="fa-regular fa-circle-xmark"></i>@Model.FailedRecipientCount неуспешни</span>
				<span class="meta-line"><i class="fa-regular fa-user-shield"></i>@Model.AdminName</span>
				<span class="meta-line">
					<i class="fa-regular fa-clock"></i>
					<time to-local no-seconds datetime="@Model.CreatedOn.ToString("O")">
						@TimeZoneInfo.ConvertTimeFromUtc(Model.CreatedOn, defaultZone)
					</time>
				</span>
			</div>
		</header>

		@if (!string.IsNullOrWhiteSpace(Model.AdditionalRecipients))
		{
			<section class="announcement-extra-recipients flex-column">
				<h2 class="subheading">Допълнителни имейли</h2>
				<p>@Model.AdditionalRecipients</p>
			</section>
		}

		<section class="announcement-editor-view">
			<div id="description-editor"></div>
			<input type="hidden" id="descriptionInput" value="@Model.MessageDelta" />
		</section>

		<section class="announcement-deliveries flex-column">
			<h2 class="subheading">Статус на доставяне</h2>

			@if (!Model.Deliveries.Any())
			{
				<p class="announcement-empty-deliveries">Няма записани опити за изпращане.</p>
			}
			else
			{
				<div class="announcement-delivery-list flex-column">
					@foreach (AnnouncementRecipientDeliveryViewModel delivery in Model.Deliveries)
					{
						<article class="announcement-delivery-item flex-row">
							<div class="announcement-delivery-icon @(delivery.IsDelivered ? "success" : "error")">
								<i class="fa-regular @(delivery.IsDelivered ? "fa-circle-check" : "fa-circle-xmark")"></i>
							</div>

							<div class="announcement-delivery-main flex-column">
								<p class="announcement-delivery-email">@delivery.Email</p>
								<p class="announcement-delivery-source">@delivery.RecipientSourceLabel</p>
								@if (!delivery.IsDelivered && !string.IsNullOrWhiteSpace(delivery.ErrorMessage))
								{
									<p class="announcement-delivery-error">@delivery.ErrorMessage</p>
								}
							</div>

							@if (delivery.DeliveredOn.HasValue)
							{
								<time class="announcement-delivery-time" to-local no-seconds datetime="@delivery.DeliveredOn.Value.ToString("O")">
									@TimeZoneInfo.ConvertTimeFromUtc(delivery.DeliveredOn.Value, defaultZone)
								</time>
							}
						</article>
					}
				</div>
			}
		</section>
	</article>
</section>

@section Scripts {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
	<script type="module" src="~/js/admin/announcement-details.js" asp-append-version="true"></script>
}
