@using MHAuthorWebsite.Web.ViewModels.Admin.UserManagement
@using static MHAuthorWebsite.GCommon.ApplicationRules.DataCollection
@model UserDetailsViewModel

<article id="user-details-container">
	<h3 class="heading">Детайли за потребителя</h3>
	
	@if (Model.IsDeleted)
	{
		<p class="deleted-message"><em>Този потребител е изтрит и детайлите му са анонимизирани и изтрити!</em></p>
	}
	
	<div class="user-badges flex-row">
		@if (Model.IsAdmin)
		{
			<span class="badge admin-badge flex-row" title="Администратор"><i class="fa-regular fa-user-shield"></i> Админ</span>
		}
		@if (Model.IsDeleted)
		{
			<span class="badge deleted-badge flex-row" title="Изтрит потребител"><i class="fa-regular fa-user-xmark"></i> Изтрит</span>
		}
		@if (Model.IsActive)
		{
			<span class="badge active-badge flex-row" title="Активен потребител през последните @UsersActivityForPeriod дни!"><i class="fa-regular fa-person-running-fast"></i> Активен</span>
		}
		@if (Model.IsBanned)
		{
			<span class="badge banned-badge flex-row" title="Блокиран потребител"><i class="fa-regular fa-user-lock"></i> Блокиран</span>
		}
	</div>
	
	
	@if (!Model.IsDeleted)
	{
		<p><strong>Име:</strong> @Model.Name</p>
		<p><strong>Имейл:</strong> @Model.Email</p>
		@if (!string.IsNullOrEmpty(Model.Phone))
		{
			<p><strong>Телефон:</strong> @Model.Phone</p>
		}
	}

	<br/>

	<p><strong>Идентификатор:</strong> @Model.Id</p>
	<p><strong>Дата на създаване на акаунт:</strong> @Model.DateJoined.ToString("dd.MM.yyyy, HH:mm")</p>
	<p><strong>Последна активност:</strong> @Model.LastActive.ToString("dd.MM.yyyy, HH:mm")</p>
</article>