@page
@using MHAuthorWebsite.Web.Utils.Mappers
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginModel

@{
	ViewData["Title"] = "Вход";
	ViewData["MetaDescription"] = "Влез в своя профил!";
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/toggle.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
	<section class="modal large flex-column">
		<h1 class="title">@ViewData["Title"]</h1>
		<form id="account" method="post" class="input-form flex-column">
			<div class="form-error" role="alert">
				@foreach (ModelError error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
				{
					<p>@error.ErrorMessage</p>
				}
				@if (!string.IsNullOrEmpty(Model.ResendConfirmationEmailUrl))
				{
					<p><a class="link active italic" href="@Model.ResendConfirmationEmailUrl">Потвърдете имейла си тук</a>.</p>
				}
			</div>
			<div class="form-input-box flex-column">
				<label class="form-label" asp-for="Input.Email">Имейл адрес</label>
				<input class="form-input" asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
				<span class="input-error" asp-validation-for="Input.Email"></span>
			</div>
			<div class="form-input-box flex-column">
				<label class="form-label" asp-for="Input.Password">Парола</label>
				<div class="password-input-wrapper">
					<input class="form-input" asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder="Парола..." />
					<button type="button" class="password-toggle-btn" aria-label="Покажи/скрий парола">
						<i class="fa-regular fa-eye"></i>
					</button>
				</div>
				<span class="input-error" asp-validation-for="Input.Password"></span>
			</div>
			
			<div class="toggle-row" style="justify-content: center; margin-bottom: 2rem;">
				<label class="switch">
					<input asp-for="Input.RememberMe" />
					<span class="toggle-slider round"></span>
				</label>
				<label class="toggle-label" asp-for="Input.RememberMe">Запомни ме?</label>
			</div>

			<button data-trigger="load-unlimited" id="login-submit" type="submit" class="btn submit-btn flex-row">
				<i class="fa-solid fa-arrow-right-to-bracket"></i> Влез
			</button>

			<div class="form-box flex-column actions">
				<p>
					<a data-trigger="load-unlimited" class="link active italic" id="forgot-password" asp-page="./ForgotPassword">Забравена парола?</a>
				</p>
				<p>
					<a data-trigger="load-unlimited" class="link active italic" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Нямаш профил? Регистрирай се!</a>
				</p>
			</div>
		</form>

		@if ((Model.ExternalLogins?.Count ?? 0) != 0)
		{
			<div class="flex-column">
				<h3 class="subheading">Вход с външен акаунт</h3>
				<form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="input-form flex-column">
					<div class="flex-row center">
						@foreach (AuthenticationScheme provider in Model.ExternalLogins!)
						{
							string iconPath = OAuthProviderMapper.ProviderIcons.TryGetValue(provider.Name, out string? path)
							? path
							: "";

							<button type="submit" class="btn @(string.IsNullOrEmpty(iconPath) ? "" : "btn-none") flex-row" name="provider" value="@provider.Name" title="Влез в системата с @provider.DisplayName акаунт">
								@if (!string.IsNullOrEmpty(iconPath))
								{
									<img src="@Url.Content(iconPath)" alt="" class="icon" />
								}
								else
								{
									<span>@provider.DisplayName</span>
								}
							</button>
						}
					</div>
				</form>
			</div>
		}
	</section>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/account/password-toggle.js" asp-append-version="true"></script>
}
