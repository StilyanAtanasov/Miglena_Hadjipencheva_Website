@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Нулиране на паролата";
}

@section Styles {
    <link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
    <section class="modal flex-column">
        <h1 class="title">@ViewData["Title"]</h1>
        <p class="info-message">
            <i class="fa-regular fa-key"></i>
            Моля, въведете Вашия имейл и новата си парола, за да завършите процеси по възстановяване.
        </p>

        <form method="post" class="input-form flex-column">
            <div asp-validation-summary="ModelOnly" class="input-error" role="alert"></div>
	        <input asp-for="Input.Code" type="hidden" />

            <div class="form-input-box flex-column">
                <label asp-for="Input.Email" class="form-label">Вашият имейл</label>
                <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="input-error"></span>
            </div>

            <div class="form-input-box flex-column">
                <label asp-for="Input.Password" class="form-label">Нова парола</label>
                <input asp-for="Input.Password" class="form-input" autocomplete="new-password" aria-required="true" placeholder="********" />
                <span asp-validation-for="Input.Password" class="input-error"></span>
            </div>

            <div class="form-input-box flex-column">
                <label asp-for="Input.ConfirmPassword" class="form-label">Потвърдете паролата</label>
                <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password" aria-required="true" placeholder="********" />
                <span asp-validation-for="Input.ConfirmPassword" class="input-error"></span>
            </div>

            <button type="submit" class="btn submit-btn flex-row">
                <i class="fa-solid fa-check"></i> Нулирай паролата
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}