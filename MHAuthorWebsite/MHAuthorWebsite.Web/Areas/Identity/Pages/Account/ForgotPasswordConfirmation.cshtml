@page
@model ForgotPasswordConfirmation

@{
	ViewData["Title"] = "Потвърдете промяната";
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
	<section class="modal flex-column">
		<h1 class="title">Почти приключихме!</h1>
		<video autoplay muted playsinline class="icon-animated big">
			<source src="~/videos/success.webm" type="video/webm">
		</video>
		
		<br/>

		<h2 class="subheading">Моля, проверете имейла си, за да нулирате вашата паролата.</h2>
		<p class="info-message">
			<i class="fa-solid fa-circle-info"></i>
			Изпратихме Ви имейл с инструкции за нулиране на паролата на @Model.Email.
			Ако не го намерите в пощенската си кутия, моля, проверете папката за спам.
		</p>
	</section>
</div>
