@page
@model ForgotPasswordModel

@{
	ViewData["Title"] = "Възстановете паролата си";
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
	<section class="modal flex-column">
		<h1 class="title">@ViewData["Title"]</h1>
		<p class="info-message">
			<i class="fa-regular fa-circle-info"></i>
			За да възстановите паролата си, въведете имейл адреса, свързан с Вашия акаунт. 
			Ще Ви изпратим имейл с инструкции за възстановяване на паролата.
		</p>

		<form method="post" class="input-form flex-column">
			<div asp-validation-summary="ModelOnly" class="input-error" role="alert"></div>
			<div class="form-input-box flex-column">
				<label asp-for="Input.Email" class="form-label">Вашият имейл</label>
				<input asp-for="Input.Email" class="form-input" autocomplete="email" aria-required="true" placeholder="name@example.com" />
				<span asp-validation-for="Input.Email" class="input-error"></span>
			</div>

			<button type="submit" class="btn submit-btn flex-row">
				<i class="fa-solid fa-arrows-repeat"></i> Възстанови
			</button>
		</form>
	</section>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
