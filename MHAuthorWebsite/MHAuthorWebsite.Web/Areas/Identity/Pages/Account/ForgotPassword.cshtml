@page
@model ForgotPasswordModel

@{
	ViewData["Title"] = "Възстановете паролата си";
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
	<section class="modal flex-column">
		<h1 class="title">@ViewData["Title"]</h1>
		<p class="info-message">
			<i class="fa-solid fa-circle-info"></i>
			За да възстановите паролата си, въведете имейл адреса, свързан с Вашия акаунт. 
			Ще Ви изпратим имейл с инструкции за възстановяване на паролата.
		</p>

		<form method="post"
			  class="input-form flex-column"
			  id="forgot-password-form"
			  data-recaptcha-v3-site-key="@Model.RecaptchaV3SiteKey"
			  data-recaptcha-v2-site-key="@Model.RecaptchaV2SiteKey"
			  data-recaptcha-manual-required="@Model.RequireManualRecaptcha.ToString().ToLowerInvariant()">
			<div asp-validation-summary="ModelOnly" class="input-error" role="alert"></div>
			<div class="form-input-box flex-column">
				<label asp-for="Input.Email" class="form-label">Вашият имейл</label>
				<input asp-for="Input.Email" class="form-input" autocomplete="email" aria-required="true" placeholder="name@example.com" />
				<span asp-validation-for="Input.Email" class="input-error"></span>
			</div>
			<input asp-for="Input.RecaptchaV3Token" type="hidden" id="forgot-password-recaptcha-v3-token" />
			<input asp-for="Input.RecaptchaV2Token" type="hidden" id="forgot-password-recaptcha-v2-token" />

			<div id="forgot-password-manual-recaptcha-box" class="form-input-box flex-column @(Model.RequireManualRecaptcha ? string.Empty : "hidden")">
				<div id="forgot-password-recaptcha-v2-widget"></div>
			</div>

			<button type="submit" class="btn submit-btn flex-row">
				<i class="fa-solid fa-arrows-repeat"></i> Възстанови
			</button>
		</form>
	</section>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script type="module" src="~/js/account/forgot-password.js" asp-append-version="true"></script>
}
