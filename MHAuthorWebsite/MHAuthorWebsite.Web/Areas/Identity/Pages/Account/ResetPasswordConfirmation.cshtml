@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
	<section class="modal flex-column">
		<h1 class="title">Готово!</h1>
		<video autoplay muted playsinline class="icon-animated big">
			<source src="~/videos/success.webm" type="video/webm">
		</video>

		<br />

		<h2 class="heading">
			Вашата парола е успешно нулирана. 
			
		</h2>

		<h3 class="subheading">
			Моля, <a class="link active" asp-page="./Login">кликнете тук, за да влезете</a>.
		</h3>

	</section>
</div>

