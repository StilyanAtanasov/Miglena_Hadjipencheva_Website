@page

@using static MHAuthorWebsite.GCommon.ApplicationRules.Pages.Account

@model IndexModel
@{
	ViewData["Heading"] = "Основна информация";
	ViewData["ActivePage"] = PersonalInfo;
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/profile/profile-page.css" asp-append-version="true" />
}

<section class="content-body flex-column">
	<form id="profile-form" class="input-form flex-column" method="post">
		<partial name="_StatusMessage" for="StatusMessage" />
		<div asp-validation-summary="ModelOnly" class="input-error" role="alert"></div>
		
		<div class="form-input-box flex-column">
			<label class="form-label" asp-for="Input.Email">Имейл</label>
			<div class="flex-row">
				<input class="form-input" asp-for="Input.Email" id="email-field" placeholder="Напишете вашият имейл..." readonly />
				<button type="button" class="btn btn-secondary" id="edit-email-btn" title="Редактирай">
					<i class="fa-solid fa-pen-to-square"></i>
				</button>
			</div>
			<span class="input-error" asp-validation-for="Input.Email"></span>
		</div>

		<div class="form-input-box flex-column">
			<label class="form-label" asp-for="Input.PhoneNumber">Телефонен номер</label>
			<input class="form-input short" asp-for="Input.PhoneNumber" placeholder="Напишете вашият телефонен номер..." />
			<span class="input-error" asp-validation-for="Input.PhoneNumber"></span>
		</div>
		<button id="update-profile-button" type="submit" class="btn submit-btn flex-row">
			<i class="fa-solid fa-floppy-disk"></i>
			Запази
		</button>
	</form>
	<i class="fa-solid fa-pencil background-icon"></i>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
	<script src="~/js/profile/my-profile.js" asp-append-version="true"></script>
}
