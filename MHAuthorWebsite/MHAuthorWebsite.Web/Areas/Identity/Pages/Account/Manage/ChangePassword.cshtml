@page

@using static MHAuthorWebsite.GCommon.ApplicationRules.Pages.Account.Settings

@model ChangePasswordModel

@{
	ViewData["Heading"] = "Промени парола";
	ViewData["ActivePage"] = Password;
}

@section Styles {
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/profile/profile-page.css" asp-append-version="true" />
}

<section class="content-body flex-column">
	<form id="change-password-form" class="input-form flex-column" method="post">
		<div asp-validation-summary="ModelOnly" role="alert"></div>
		<div class="form-input-box flex-column">
			<label class="form-label" asp-for="Input.OldPassword">Стара парола</label>
			<div class="password-input-wrapper">
				<input class="form-input" asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" placeholder="Стара парола..." />
				<button type="button" class="password-toggle-btn" aria-label="Покажи/скрий парола">
					<i class="fa-regular fa-eye"></i>
				</button>
			</div>
			<span class="input-error" asp-validation-for="Input.OldPassword"></span>
		</div>
		<div class="form-input-box flex-column">
			<label class="form-label" asp-for="Input.NewPassword">Нова парола</label>
			<div class="password-input-wrapper">
				<input class="form-input" asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" placeholder="Нова парола..." />
				<button type="button" class="password-toggle-btn" aria-label="Покажи/скрий парола">
					<i class="fa-regular fa-eye"></i>
				</button>
			</div>
			<span class="input-error" asp-validation-for="Input.NewPassword"></span>
		</div>
		<div class="form-input-box flex-column">
			<label class="form-label" asp-for="Input.ConfirmPassword">Потвърдете новата парола</label>
			<div class="password-input-wrapper">
				<input class="form-input" asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Потвърдете новата парола..." />
				<button type="button" class="password-toggle-btn" aria-label="Покажи/скрий парола">
					<i class="fa-regular fa-eye"></i>
				</button>
			</div>
			<span class="input-error" asp-validation-for="Input.ConfirmPassword"></span>
		</div>

		<button id="update-profile-button" type="submit" class="btn submit-btn flex-row">
			<i class="fa-solid fa-pen-to-square"></i>
			Обнови парола
		</button>
	</form>
	<i class="fa-solid fa-key background-icon"></i>
</section>

			
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/account/password-toggle.js" asp-append-version="true"></script>
}