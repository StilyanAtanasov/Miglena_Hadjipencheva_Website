@using Microsoft.AspNetCore.Mvc.TagHelpers
@using MHAuthorWebsite.Core.Models
@using static MHAuthorWebsite.GCommon.ApplicationRules.Pages.Account

@inject SignInManager<ApplicationUser> SignInManager

@{
	bool hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
	string currentPage = ViewData["ActivePage"] as string ?? "";
}

<nav class="profile-nav">
	<ul class="profile-nav-elements flex-column">
		<li class="side-nav-element flex-row @(currentPage == PersonalInfo ? "current" : "")">
			<a class="link flex-row" id="profile" asp-area="Identity"  asp-page="/Account/Manage/Index">
				<i class="fa-solid fa-pencil"></i>
				Основна информация
			</a>
		</li>
		<li class="side-nav-element flex-row @(currentPage == MyOrders ? "current" : "")">
			<a class="link flex-row" asp-controller="Order" asp-action="MyOrders">
				<i class="fa-solid fa-truck-fast"></i>
				Вашите поръчки
			</a>
		</li>
		<li class="side-nav-element @(Settings.All.Contains(currentPage) ? "current" : "")"> 
			<div class="flex-row">
				<p class="link flex-row">
					<i class="fa-solid fa-gear"></i>
					Настройки
				</p>
			
				<div class="nav-arrow"></div>
			</div>

			<ul class="inner-nav flex-column">
				<li class="inner-nav-element @(currentPage == Settings.Password ? "current" : "")">
					<a class="link flex-row" id="change-password" asp-area="Identity"  asp-page="/Account/Manage/ChangePassword">
						<i class="fa-solid fa-key"></i>
						Пароли
					</a>
				</li>
				@if (hasExternalLogins)
				{
					<li class="inner-nav-element @(currentPage == Settings.ExternalAccounts ? "current" : "")">
						<a id="external-login" class="link flex-row" asp-area="Identity" asp-page="/Account/Manage/ExternalLogins">
							<i class="fa-solid fa-arrow-up-right-from-square"></i>
							Външни акаунти
						</a>
					</li>
				}
				<li class="inner-nav-element @(currentPage == Settings.TFA ? "current" : "")">
					<a class="link flex-row" id="two-factor" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">
						<i class="fa-solid fa-user-shield"></i>
						Двуфакторна автентикация
					</a>
				</li>
				<li class="inner-nav-element @(currentPage == Settings.PrivatePersonalInfo ? "current" : "")">
					<a class="link flex-row" id="personal-data" asp-area="Identity" asp-page="/Account/Manage/PersonalData">
						<i class="fa-solid fa-id-card"></i>
						Лични данни
					</a>
				</li>
				<li class="inner-nav-element @(currentPage == Settings.EmailPreferences ? "current" : "")">
					<a class="link flex-row" id="email-preferences" asp-area="Identity" asp-page="/Account/Manage/EmailPreferences">
						<i class="fa-solid fa-envelope-open-text"></i>
						Имейл предпочитания
					</a>
				</li>
				<li class="inner-nav-element @(currentPage == Settings.LegalBinding ? "current" : "")">
					<a class="link flex-row" id="legal-agreements" asp-area="Identity" asp-page="/Account/Manage/LegalAgreements">
						<i class="fa-solid fa-file-signature"></i>
						Правни съгласия
					</a>
				</li>
			</ul>
		</li>
	</ul>
</nav>
