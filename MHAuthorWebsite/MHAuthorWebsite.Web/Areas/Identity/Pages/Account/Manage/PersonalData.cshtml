@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PersonalDataModel
@{
	ViewData["Heading"] = "Лични данни";
	ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

@section Styles
{
	<link rel="stylesheet" href="~/css/profile/profile-page.css" asp-append-version="true" />
}

<section class="content-body flex-column">
	<p>
		Вашият акаунт съдържа лични данни, които сте ни предоставили!
		<br />
		Спрямо GDPR регламента имате право да изтеглите или изтриете вашите лични данни!
	</p>

	<div class="action-buttons flex-row">
		<form id="download-data" asp-page="DownloadPersonalData" method="post">
			<button type="submit" class="btn flex-row">
				<i class="fa-solid fa-down-to-bracket"></i>
				Изтегли лични данни
			</button>
		</form>
		<p>
			<a class="btn link flex-row" asp-page="DeletePersonalData">
				<i class="fa-solid fa-circle-user-circle-minus"></i>
				Изтрий лични данни
			</a>
		</p>
	</div>
	<i class="fa-solid fa-id-card background-icon"></i>
</section>