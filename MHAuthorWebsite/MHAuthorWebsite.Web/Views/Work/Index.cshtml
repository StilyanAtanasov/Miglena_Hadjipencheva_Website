@using MHAuthorWebsite.Core.Dtos.Work
@using MHAuthorWebsite.Web.ViewModels.Shared
@using MHAuthorWebsite.Web.ViewModels.Shared.Enums
@inject Microsoft.Extensions.Options.IOptions<MHAuthorWebsite.Core.Configuration.Security.RecaptchaSettings> RecaptchaOptions
@model ICollection<WorkCardDto>

@{
    ViewData["Title"] = "РўРІРѕСЂС‡РµСЃС‚РІРѕ";
    bool isAdmin = User.IsInRole("Admin");
    
    int worksCount = ViewBag.WorksCount ?? Model.Count;
    string? currentSearch = ViewBag.CurrentSearch;
    string recaptchaV3SiteKey = RecaptchaOptions.Value.V3SiteKey;
    string recaptchaV2SiteKey = RecaptchaOptions.Value.V2SiteKey;
}

@section Styles {
    <link rel="stylesheet" href="~/css/elements/search-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/elements/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/works.css" asp-append-version="true" />
}

<section class="works-hero">
    <div class="works-hero-content">
        <a class="back-btn works-back-btn" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i> Назад към начало
        </a>
        <h1 class="title">РўРІРѕСЂС‡РµСЃС‚РІРѕ</h1>
        <p>Р Р°Р·РіР»РµРґР°Р№С‚Рµ РєРѕР»РµРєС†РёСЏС‚Р° РѕС‚ С‚РІРѕСЂР±Рё Рё РїСѓР±Р»РёРєР°С†РёРё РЅР° РњРёРіР»РµРЅР° РҐР°РґР¶РёРїРµРЅС‡РµРІР°.</p>
        
        @if (isAdmin)
        {
            <a asp-area="Admin" asp-controller="AdminWork" asp-action="Add" class="btn link work-add-btn">
                <i class="fa-solid fa-plus"></i> Р”РѕР±Р°РІРё С‚РІРѕСЂР±Р°
            </a>
        }
    </div>
</section>

<section class="works-container" id="works-container">
    @if (worksCount > 0 || !string.IsNullOrEmpty(currentSearch))
    {
        <div class="works-actions">
            @await Html.PartialAsync("_SearchBar", new SearchBarViewModel
            {
                FormCustomId = "work-search-form",
                InputCustomId = "work-search-input",
                PlaceholderText = "РўСЉСЂСЃРµС‚Рµ С‚РІРѕСЂР±Рё РїРѕ Р·Р°РіР»Р°РІРёРµ...",
                DefaultValue = currentSearch,
                Align = SearchBarAlignOptions.Center,
                EnableRecaptchaV3 = true,
                RecaptchaV3SiteKey = recaptchaV3SiteKey,
                RecaptchaV3Action = "work_search",
                RecaptchaV2SiteKey = recaptchaV2SiteKey
            })
        </div>
    }

    @if (Model.Any())
    {
        @await Html.PartialAsync("_WorkCardsPartial", Model)
    }
    else
    {
        <div class="no-works-message">
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <i class="fa-solid fa-filter"></i>
                <p>РќСЏРјР° РЅР°РјРµСЂРµРЅРё С‚РІРѕСЂР±Рё Р·Р°: @currentSearch</p>
            }
            else
            {
                <i class="fa-regular fa-books"></i>
                <p>Р’СЃРµ РѕС‰Рµ РЅСЏРјР° РґРѕР±Р°РІРµРЅРё С‚РІРѕСЂР±Рё.</p>
            }
        </div>
    }
</section>

@section Scripts {
    <script type="module" src="~/js/works.js" asp-append-version="true"></script>
}

