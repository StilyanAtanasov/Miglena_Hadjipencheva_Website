@using MHAuthorWebsite.Web.ViewModels.ProductComment
@using static MHAuthorWebsite.GCommon.EntityConstraints.ProductComment
@using static MHAuthorWebsite.GCommon.ApplicationRules.ProductCommentImages
@model EditProductCommentViewModel

@{
	ViewData["Title"] = "Редактиране на коментар";
}

@section Styles {
	<link rel="stylesheet" href="~/css/elements/stars.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/image-preview.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/product-comment-form.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/input-form.css" asp-append-version="true" />
}

<div class="page-wrapper flex-column">
	<section class="modal-invisible large flex-column">
		<h1 class="title">@ViewData["Title"]</h1>

		<form id="edit-comment-form" class="input-form flex-column" asp-controller="ProductComment" asp-action="Edit" method="post" enctype="multipart/form-data">
			<input type="hidden" asp-for="ProductId" value="@Model.ProductId" />
			<input type="hidden" asp-for="CommentId" value="@Model.CommentId" />
			<input type="hidden" asp-for="ParentCommentId" value="@Model.ParentCommentId" />
			<input type="hidden" asp-for="ReplyCommentId" value="@Model.ReplyCommentId" />

			@if (Model.ParentCommentId == null)
			{
				<div class="form-input-box flex-column">
					<label class="form-label" asp-for="Rating">Рейтинг:</label>
					@await Html.PartialAsync("_StarsInput", new StarsInputViewModel
					       {
						       MaxValue = RatingMaxValue, 
						       InputName = nameof(Model.Rating), 
						       Rating = (byte)Model.Rating!
					       })
					<span class="input-error" asp-validation-for="Rating"></span>
				</div>
			}

			<div class="form-input-box flex-column">
				<label class="form-label" asp-for="Text">Коментар:</label>
				<textarea class="form-input" asp-for="Text"></textarea>
				<span class="input-error" asp-validation-for="Text"></span>
			</div>

			@if (Model.ParentCommentId == null)
			{
				<div class="form-input-box flex-column">
					<label class="form-label" asp-for="NewImages">Изображения:</label>
					<input type="file" id="imageInput" class="form-input" asp-for="NewImages" multiple accept="image/*"></input>
					<span id="image-error" class="input-error" asp-validation-for="NewImages" data-max-images="@(MaxImagesPerComment - Model.ImagePreviewUrls.Count)"></span>
				</div>

				<div id="previewContainer" class="form-box preview-container flex-row @((Model.ImagePreviewUrls.Count == 0) ? "hidden" : "")">
					@foreach (EditProductCommentImageViewModel image in Model.ImagePreviewUrls)
					{
						<div class="image-container" data-id="@image.ImageId">
							<img src="@image.PreviewUrl" alt="Comment Image" />
							<button type="button" class="removeBtn" title="Премахни изображението">
								<i class="fa-solid fa-file-slash"></i>
							</button>
						</div>
					}
				</div>
			}

			<button data-trigger="load-unlimited" type="submit" class="btn link submit-btn flex-row">
				<i class="fa-solid fa-comment-pen"></i> Запази
			</button>
		</form>
	</section>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/elements/stars-input.js" asp-append-version="true"></script>
	<script type="module" src="~/js/edit-comment.js" asp-append-version="true"></script>
}