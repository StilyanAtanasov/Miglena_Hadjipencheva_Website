@using MHAuthorWebsite.Web.ViewModels.ProductComment
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using MHAuthorWebsite.Core.Models.Enums
@using static MHAuthorWebsite.GCommon.ApplicationRules.Application
@using static MHAuthorWebsite.GCommon.EntityConstraints.ProductComment

@model ICollection<ProductBaseCommentViewModel>

@{
	TimeZoneInfo defaultZone = TimeZoneInfo.FindSystemTimeZoneById(DefaultTimeZoneId);
}

@foreach (ProductBaseCommentViewModel c in Model)
{
	<div class="comment flex-row" data-rating="@c.Rating">
		<div class="comment-info">
			<div class="flex-row">
				<i class="fa-solid fa-comment-dots"></i>
				<p>@c.UserName</p>
			</div>
			<div class="dates flex-row">
				<p class="date">
					<time to-local date-only datetime="@c.Date.ToString("O")">
						@TimeZoneInfo.ConvertTimeFromUtc(c.Date, defaultZone).ToString("dd.MM.yyyy")
					</time>
				</p>
				@if(c.LastEdited.HasValue)
				{
					<span class="edited-date" title="Последно редактиран на @TimeZoneInfo.ConvertTimeFromUtc(c.LastEdited.Value.Date, defaultZone).ToString(" dd.MM.yyyy")">
						<i class="fa-solid fa-pen"></i>
					</span>
				}
			</div>
		</div>
		<hr class="vertical comment-divider" />
		<div class="comment-main">
			<div class="rating-box flex-row">
				@await Html.PartialAsync("_Stars", ((decimal)c.Rating, RatingMaxValue))
				@if (c.VerifiedPurchase)
				{
					<p class="verified-badge flex-row"><i class="fa-solid fa-badge-check"></i> Потвърдена поръчка!</p>
				}
			</div>
			<p class="text">@c.Text</p>
			@if (c.ImageUrls.Count > 0)
			{
				<div class="images flex-row" data-comment-id="@c.Id">
					@foreach (string imageUrl in c.ImageUrls)
					{
						<img class="comment-image" src="@imageUrl" alt="Comment Image" />
					}
				</div>
			}
			<div class="comment-actions flex-row">
				<div class="comment-reactions flex-row" data-comment-id="@c.Id">
					<button class="react-btn btn-none link" data-reaction-type="@((int)CommentReaction.Like)">
						<i class="fa-solid @(c.UserReaction == CommentReaction.Like ? "" : "regular") fa-thumbs-up"></i>
						<span class="reaction-count">@c.Likes</span>
					</button>
					<button class="react-btn btn-none link" data-reaction-type="@((int)CommentReaction.Dislike)">
						<i class="fa-solid @(c.UserReaction == CommentReaction.Dislike ? "" : "regular") fa-thumbs-down"></i>
						<span class="reaction-count">@c.Dislikes</span>
					</button>
				</div>
				<div>
					<a class="reply-btn btn-none link" asp-controller="ProductComment" asp-action="AddComment"
					   asp-route-productId="@c.ProductId" asp-route-parentCommentId="@c.Id"
					   asp-route-targetName="@c.UserName" aria-label="Отговори на @c.UserName">
						<i class="fa-solid @(c.TotalRepliesCount > 0 ? "" : "regular") fa-reply"></i>
						@(c.TotalRepliesCount)
					</a>
				</div>
				@if (c.IsUserAuthor)
				{
					<div>
						<a class="btn-none link" asp-controller="ProductComment" asp-action="Edit"
						   asp-route-commentId="@c.Id" aria-label="Редактирай коментар">
							<i class="fa-solid fa-pen"></i>
						</a>

						<button class="delete-btn btn-none link" data-comment-id="@c.Id" data-product-id="@c.ProductId" aria-label="Изтрий коментар">
							<i class="fa-solid fa-trash"></i>
						</button>
					</div>
				}
			</div>
		</div>
	</div>

	@await Html.PartialAsync("_CommentReplies.cshtml", c.Replies)

	@if (c.HasMoreReplies)
	{
		<button class="load-replies-btn btn-none link" data-comment-id="@c.Id" data-last-loaded-page="1">
			<i class="fa-solid fa-circle-chevron-down"></i>
			Още отговори
		</button>
	}

	<hr />
}