@using MHAuthorWebsite.Web.ViewModels.ProductComment
@using MHAuthorWebsite.Core.Models.Enums
@model ProductCommentDetailsViewModel

<section class="comment-details-section flex-column">
	<div class="comment-gallery flex-row">
		<div class="main-image flex-row">
			<img src="@Model.Images.FirstOrDefault()?.ImageUrl" alt="Main comment image" id="main-comment-image" />
		</div>
		<hr class="vertical" />
		<div class="image-previews">
			@for (int i = 0; i < Model.Images.Count; i++)
			{
				ProductCommentImageViewModel image = Model.Images.ElementAt(i);
				<img src="@image.ImagePreviewUrl" data-original-url="@image.ImageUrl" alt="Preview image" class="preview-thumb @(i == 0 ? "active" : "")" />
			}
		</div>
	</div>

	<div class="comment-info">
		<div class="comment-rating flex-row">
			<div class="flex-row">
				<div class="rating-stars flex-row">
					@for (int i = 1; i <= 5; i++)
					{
						<i class="fa-star @(i <= Model.Rating ? "fa-solid" : "fa-regular")"></i>
					}
				</div>
				@if (Model.VerifiedPurchase)
				{
					<p class="verified-badge flex-row"><i class="fa-solid fa-badge-check"></i> Потвърдена поръчка!</p>
				}
			</div>
			<span class="date">@Model.Date.ToString("dd.MM.yyyy")</span>
		</div>

		<p class="comment-user">@Model.UserName</p>
		<p class="comment-text">@Model.Text</p>

		<div class="comment-reactions flex-row" data-comment-id="@Model.Id">
			<button class="react-btn btn-none link" data-reaction-type="@((int)CommentReaction.Like)">
				<i class="@(Model.UserReaction == CommentReaction.Like ? "fa-solid" : "fa-regular") fa-thumbs-up"></i>
				<span class="reaction-count">@Model.Likes</span>
			</button>
			<button class="react-btn btn-none link" data-reaction-type="@((int)CommentReaction.Dislike)">
				<i class="@(Model.UserReaction == CommentReaction.Dislike ? "fa-solid" : "fa-regular") fa-thumbs-down"></i>
				<span class="reaction-count">@Model.Dislikes</span>
			</button>
		</div>
	</div>
</section>