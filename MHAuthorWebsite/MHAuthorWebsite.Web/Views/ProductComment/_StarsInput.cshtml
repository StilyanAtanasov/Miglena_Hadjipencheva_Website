@using MHAuthorWebsite.Web.ViewModels.ProductComment
@model StarsInputViewModel

<div class="stars">
	<div class="stars-row flex-row">
		@for (int i = 1; i <= Model.MaxValue; i++)
		{
			<i data-index="@i" class=" fa-star star-icon @(Model.Rating >= i ? "fa-solid" : "fa-solid")"></i>
		}
	</div>
	<input class="rating-input" type="hidden" name="@Model.InputName" value="@Model.Rating" />
</div>