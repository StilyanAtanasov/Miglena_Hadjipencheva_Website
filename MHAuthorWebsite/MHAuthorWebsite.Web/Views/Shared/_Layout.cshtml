@using MHAuthorWebsite.GCommon
@using static MHAuthorWebsite.GCommon.ApplicationRules.Application
@inject IWebHostEnvironment Env

@{
	string? currentPage = ViewData["CurrentPage"]?.ToString();
}

<!DOCTYPE html>
<html lang="bg">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />

	@if (ViewData["MetaDescription"] != null)
	{
		<meta name="description" content="@ViewData["MetaDescription"]" />
	}
	else
	{
		<meta name="description" content="Добре дошли в официалния сайт на Миглена Хаджипенчева. Разгледайте най-новите творби и книги и поръчайте онлайн." />
	}

	<title>@ViewData["Title"] - @WebsiteName</title>
	<link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
	<link rel="stylesheet" href="~/css/common.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/loadingScreen.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/inline-loader.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/scroll-to-top.css" asp-append-version="true" />

	<link rel="icon" type="image/x-icon" href="~/img/icons/favicon.ico">
	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
	<header class="mobile-nav-closed">
		<nav class="flex-row">
			<h4><a asp-controller="Home" asp-action="Index" class="title-small active">Миглена Хаджипенчева</a></h4>
			<ul class="header-nav central-nav flex-row">
				<li class="icon-link-container">
					<a data-trigger="load-unlimited"
					   class="icon-link-active active flex-row @(currentPage == ApplicationRules.Pages.MainNavigation.Home ? "current-page" : "")" 
					   asp-controller="Home" asp-action="Index">
						<i class="fa-solid regular fa-house"></i>
						<span class="link-text">Начало</span>
					</a>
				</li>
				<li class="icon-link-container">
					<a data-trigger="load-unlimited" 
					   class="icon-link-active active flex-row @(currentPage == ApplicationRules.Pages.MainNavigation.Store ? "current-page" : "")"
					   asp-controller="Product" asp-action="AllProducts">
						<i class="fa-solid regular fa-shop"></i>
						<span class="link-text">Магазин</span>
					</a>
				</li>
				<li class="icon-link-container">
					<a data-trigger="load-unlimited" 
					   class="icon-link-active long active flex-row @(currentPage == ApplicationRules.Pages.MainNavigation.Works ? "current-page" : "")"
					   asp-controller="Work" asp-action="Index">
						<i class="fa-solid regular fa-pen"></i>
						<span class="link-text">Творчество</span>
					</a>
				</li>
				<li class="icon-link-container">
					<a data-trigger="load-unlimited" 
					   class="icon-link-active active flex-row @(currentPage == ApplicationRules.Pages.MainNavigation.Liked ? "current-page" : "")"
					   asp-controller="Product" asp-action="LikedProducts">
						<i class="fa-solid regular fa-heart-circle-check"></i> 
						<span class="link-text">Любими</span>
					</a>
				</li>
				<li class="icon-link-container">
					<a data-trigger="load-unlimited" 
					   class="icon-link-active active flex-row @(currentPage == ApplicationRules.Pages.MainNavigation.Cart ? "current-page" : "")"
					   asp-controller="cart" asp-action="Index">
						<i class="fa-solid regular fa-cart-shopping"></i>
						<span class="link-text">Количка</span>
					</a>
				</li>
				<li class="icon-link-container">
					<a data-trigger="load-unlimited"
					   class="icon-link-active long active flex-row @(currentPage == ApplicationRules.Pages.MainNavigation.Contacts ? "current-page" : "")"
					   asp-controller="Contacts" asp-action="Index">
						<i class="fa-solid regular fa-phone"></i>
						<span class="link-text">Контакти</span>
					</a>
				</li>

				@if ((User.Identity?.IsAuthenticated ?? false) && User.IsInRole("Admin"))
				{
					<li class="icon-link-container">
						<a data-trigger="load-unlimited" class="icon-link-active long active flex-row" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Dashboard">
							<i class="fa-solid regular fa-screwdriver-wrench"></i>
							<span class="link-text">Админ панел</span>
						</a>
					</li>
				}
			</ul>
			<partial name="_LoginPartial" />
			<div id="bars" class="bars flex-column">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</div>
		</nav>
	</header>

	<nav id="navLists" class="flex-column hide"></nav>
	<div id="loading-screen" class="show">
		<span id="loader"></span>
	</div>

	<main role="main">
		@RenderBody()

		@if (Env.IsStaging())
		{
			<div id="btn-popup-staging-notice" class="popup-btn-box staging-notice flex-row">
				<p class="popup-btn-text invisible"><strong>ВНИМАНИЕ:</strong> Тази версия на сайта е тестова. Поръчките не се вземат в предвид. Моля, не въвеждайте чувствителна информация в сайта. За да посетите официалния сайт кликнете <a href="https://miglena-hadjipencheva.com">тук</a></p>
				<button class="btn popup-btn"><i class="fa-solid fa-circle-exclamation"></i></button>
			</div>
		}
	</main>

	<footer class="footer flex-row">
		<div class="footer-links flex-row">
			<section class="footer-links-group flex-column">
				<h5 class="footer-links-group-title">Връзки</h5>
				<a class="link active" asp-controller="Home" asp-action="Index">Начало</a>
				<a class="link active" asp-controller="Home" asp-action="Index" asp-fragment="about-me">За мен</a>
				<a class="link active" asp-controller="Product" asp-action="AllProducts">Магазин</a>
				<a class="link active" asp-controller="Work" asp-action="Index">Творчество</a>
			</section>

			<section class="footer-links-group flex-column">
				<h5 class="footer-links-group-title">Контакти и помощ</h5>
				<a class="link active" asp-controller="Contacts" asp-action="Index">Контакти</a>
				<a class="link active" asp-controller="Home" asp-action="Faq">Често задавани въпроси</a>
			</section>

			<section class="footer-links-group flex-column">
				<h5 class="footer-links-group-title">Правни документи</h5>
				<a class="link active" asp-controller="Home" asp-action="PrivacyPolicy">Политика за поверителност</a>
				<a class="link active" asp-controller="Home" asp-action="TermsOfService">Общи условия</a>
			</section>
		</div>

		<section>
			<section class="footer-quote flex-row" aria-live="polite">
				<i class="fa-solid fa-quote-right background-icon" aria-hidden="true"></i>
				<p id="footer-quote-text" class="footer-quote-text"></p>
				<button id="footer-quote-regenerate-btn" type="button" class="footer-quote-regenerate-btn">
					<i class="fa-solid fa-rotate"></i>
				</button>
			</section>

			<section class="footer-brand flex-row">
				<p class="copyright-owner">&copy; @(DateTime.Now.Year) - Миглена Хаджипенчева</p>
				<ul class="social-media flex-row">
					<li>
						<a data-trigger="load-unlimited" href="https://www.facebook.com/megi.bassoon" target="_blank" rel="noopener noreferrer" aria-label="Фейсбук страница">
							<i class="fa-brands fa-facebook"></i>
						</a>
					</li>
					<li>
						<a data-trigger="load-unlimited" href="https://www.instagram.com/mighadzhipencheva/" target="_blank" rel="noopener noreferrer" aria-label="Инстаграм страница">
							<i class="fa-brands fa-instagram"></i>
						</a>
					</li>
					<li>
						<a data-trigger="load-unlimited" href="https://www.youtube.com/@@%D0%9C%D0%B8%D0%B3%D0%BB%D0%B5%D0%BD%D0%B0%D0%A5%D0%B0%D0%B4%D0%B6%D0%B8%D0%BF%D0%B5%D0%BD%D1%87%D0%B5%D0%B2%D0%B0" target="_blank" rel="noopener noreferrer" aria-label="Ютуб канал">
							<i class="fa-brands fa-youtube"></i>
						</a>
					</li>
				</ul>
			</section>
		</section>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/js/layout.js" asp-append-version="true"></script>
	<script src="~/js/elements/footer-quote-generator.js" asp-append-version="true"></script>
	<script src="~/js/loadingScreen.js" asp-append-version="true"></script>
	<script type="module" src="~/js/elements/scroll-to-top.js" asp-append-version="true"></script>

	@if (ViewData["RequireTimeZoneManager"] is not null && (bool)ViewData["RequireTimeZoneManager"]!)
	{
		<script type="module" src="~/js/time-zone-manager.js" asp-append-version="true"></script>
	}

	@if (Env.IsStaging())
	{
		<script src="~/js/elements/popup-btn.js" asp-append-version="true"></script>
	}

	@if (Env.IsStaging())
	{
		<script src="~/js/elements/popup-btn.js" asp-append-version="true"></script>
	}

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
