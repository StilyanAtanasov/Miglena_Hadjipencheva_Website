@using MHAuthorWebsite.Web.ViewModels.Product
@using MHAuthorWebsite.GCommon
@using MHAuthorWebsite.Web.ViewModels.Shared
@using MHAuthorWebsite.Web.ViewModels.Shared.Enums
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Options.IOptions<MHAuthorWebsite.Core.Configuration.Security.RecaptchaSettings> RecaptchaOptions
@model ICollection<ProductCardViewModel>

@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.22.3/dist/sweetalert2.min.css" rel="stylesheet">
	<link rel="stylesheet" href="~/css/elements/notification.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/select.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/search-bar.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/pagination.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/elements/loader.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
}

@{
	ViewData["Title"] = "Магазин";
	ViewData["MetaDescription"] = "Разгледайте наличните книги на Миглена Хаджипенчева и поръчайте онлайн!";
	ViewData["CurrentPage"] = ApplicationRules.Pages.MainNavigation.Store;

	int productsCount = ViewBag.ProductsCount ?? Model.Count;

	string orderType = Context.Request.Query["orderType"].ToString();
	SelectList selectItems = new(
		ApplicationRules.SortTypes.DisplayNames.Select(kvp =>
			new SelectListItem(kvp.Value, kvp.Key)),
		"Value",
		"Text",
		orderType);

	string? currentSearch = Context.Request.Query["search"];
	string recaptchaV3SiteKey = RecaptchaOptions.Value.V3SiteKey;
	string recaptchaV2SiteKey = RecaptchaOptions.Value.V2SiteKey;
}

<section class="page-wrapper flex-column">
	<h1 class="title">Магазин</h1>

	@if (productsCount > 0 || !string.IsNullOrEmpty(currentSearch))
	{
		<div class="shop-action-btns flex-row">

			@await Html.PartialAsync("_SearchBar", new SearchBarViewModel
			       {
				       FormCustomId = "product-search-form",
				       InputCustomId = "product-search-input",
				       PlaceholderText = "Търсете продукти по име, категория или описание...",
				       DefaultValue = currentSearch,
				       Align = SearchBarAlignOptions.Left,
				       EnableRecaptchaV3 = true,
				       RecaptchaV3SiteKey = recaptchaV3SiteKey,
				       RecaptchaV3Action = "product_search",
				       RecaptchaV2SiteKey = recaptchaV2SiteKey
			       })

			<div class="shop-action-btn flex-row">
				<label for="order-by-select">Подреди по:</label>
				<select id="order-by-select" class="select-main" autocomplete="off" name="orderType" asp-items="@selectItems"></select>
			</div>
		</div>
		}

	<section id="products-page">
		@await Html.PartialAsync("_ProductCardsPartial", Model)
	</section>

	<form class="hidden">@Html.AntiForgeryToken()</form>
</section>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
	<script type="module"  src="~/js/elements/select.js" asp-append-version="true"></script>
	<script src="~/js/click.js" asp-append-version="true"></script>
	<script type="module" src="~/js/notification.js" asp-append-version="true"></script>
	<script type="module" src="~/js/store.js" asp-append-version="true"></script>
	<script type="module" src="~/js/add-to-cart.js" asp-append-version="true"></script>
}