@using MHAuthorWebsite.Web.ViewModels.Product
@using static MHAuthorWebsite.GCommon.ApplicationRules.CurrencyRates

@model ICollection<ProductCardViewModel>

@foreach (ProductCardViewModel product in Model)
{
	<div class="product flex-column clickable" data-details-url="@Url.Action("Details", "Product", new { productId = product.Id })">
		@if (product.DiscountPrice.HasValue)
		{
			<div class="product-badge">
				<i class="fa-solid fa-badge"></i>
				<span class="badge-text">- @(Math.Ceiling((product.Price - product.DiscountPrice.Value) / product.Price * 100))%</span>
			</div>
		}

		<div class="product-image-container flex-row">
			<img class="product-image" src="@product.ImageUrl" alt="@(product.ImageAlt)" />
		</div>
		<div class="product-title-container">
			<h4 class="product-title"><a data-trigger="load-unlimited" class="name" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h4>
			<span class="text-faded">@product.ProductType</span>
		</div>
		<div class="price-box flex-column">
			<p class="price @((product.DiscountPrice.HasValue) ? "old-price" : "")">@product.Price.ToString("F2") лв. / @((product.Price * LevToEurRate).ToString("F2")) €</p>
			@if (product.DiscountPrice.HasValue)
			{
				<p class="price discounted-price">@product.DiscountPrice.Value.ToString("F2") лв. / @((product.DiscountPrice.Value * LevToEurRate).ToString("F2")) €</p>
			}

			<span class="price-text @(product.IsAvailable ? "available" : "unavailable")">@(product.IsAvailable ? "В наличност" : "Изчерпана наличност")</span>
		</div>
		<div class="action-btns flex-row">
			<button data-role="remove-item" data-item-id="@product.Id" class="btn like @(product.IsLiked ? "liked" : "")" aria-label="like">
				<span class="fa-stack">
					<i class="fa-regular fa-heart fa-stack-2x"></i>
					<i class="fa-solid fa-heart fa-stack-2x"></i>
				</span>
			</button>
			<input id="quantity" type="hidden" name="quantity" value="1" />
			<button data-role="add-to-cart" data-item-id="@product.Id" class="btn order flex-row" @(product.IsAvailable ? "" : "disabled")>
				<i class="fa-solid fa-cart-shopping-fast"></i> Поръчай
			</button>
		</div>
	</div>
}