    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="NotificationTemplates\Razor Templates\OrderStatusUpdateNotificationTemplate.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
